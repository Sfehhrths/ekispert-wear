<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Held by us; the patched Ekispert app sends its broadcasts with
         sendBroadcast(intent, "dev.sfehhrths.ekispertwear.permission.RECEIVE_TAP"),
         so only apps granted this permission can receive them. -->
    <permission
        android:name="dev.sfehhrths.ekispertwear.permission.RECEIVE_TAP"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.sfehhrths.ekispertwear.permission.RECEIVE_TAP" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Explicit (setPackage) broadcasts from the patched app land here.
             The sender is verified by uid in TapReceiver (Android 14+ share-identity). -->
        <receiver
            android:name=".tap.TapReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.sfehhrths.ekispertwear.action.TAP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
